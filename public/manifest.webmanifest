{
  "name": "JustShare",
  "short_name": "JustShare",
  "description": "Share files with nearby devices, privately.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f0f10",
  "theme_color": "#0f0f10",
  "icons": [
    { "src": "/icons/icon-192.png?v=1", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png?v=1", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png?v=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg?v=1", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["*/*"] }] }
  }
}
